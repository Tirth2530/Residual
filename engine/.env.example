# Copy to .env and fill in. Everything is optional: without keys the app still
# runs (browser speech, alerts logged to the console).

# Natural voice for spoken phrases (MLH Best Use of ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Caregiver alert: install the free ntfy app on a phone and subscribe to this topic.
# Pick something unguessable, e.g. residual-lahacks-7f3k2
NTFY_TOPIC=
# Or any webhook that accepts a JSON POST
ALERT_WEBHOOK_URL=

# Drive other software: off | switch (press SWITCH_KEY per detected gesture) | type (type the phrase)
KEYSTROKES=off
SWITCH_KEY=space
