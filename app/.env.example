# AI web mode (Browser Use), for sites without built-in actions. Never commit the real key.
BROWSER_USE_API_KEY=

# Optional: the person's own words in a higher-quality ElevenLabs voice. Without it, the system voice.
ELEVENLABS_API_KEY=
# Optional: a voice id from your ElevenLabs voice library (default: a stock voice)
ELEVENLABS_VOICE_ID=
