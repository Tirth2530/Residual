# ---- Agentverse / ASI -------------------------------------------------------------
AGENT_NAME=Residual Relay
# REQUIRED (20+ characters). It IS the agent's identity/address (anyone who has it can impersonate the agent), so keep it ONLY in
# your private .env, never in this example file, and keep it fixed. The care circle, the Concierge and the Hands get their own
# identities derived from this one seed, so there is nothing else to store:
#   python -c "import secrets; print(secrets.token_hex(32))"
AGENT_SEED=
# Local experiments only: lets the agent start with a throwaway identity (a new address every run)
ALLOW_EPHEMERAL_AGENT=
# Optional @handle on Agentverse (set it in the dashboard if this is rejected)
AGENT_HANDLE=residualai
AGENT_PORT=8001
# Optional: lets ASI:One parse free-form requests (deterministic parsing is used without it)
ASI1_API_KEY=

# ---- Photon 2.0 (one channel) -------------------------------------------------------
# auto: live if PHOTON_PROJECT_ID and PHOTON_API_KEY are set, otherwise SIMULATED (nothing reaches a phone)
# simulated: never send, whatever is set (use this for the agent until its webhook is ready)
# live: refuse to start without them
PHOTON_MODE=auto
PHOTON_PLATFORM=imessage          # or sms
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
PHOTON_AGENT_USER_ID=             # OPTIONAL. Leave empty on shared iMessage lines: each contact's agent is found from the line they were assigned
PHOTON_WEBHOOK_SECRET=            # REQUIRED when live (the agent refuses to start without it)
PHOTON_BASE=https://api.photon.codes/v1

# ---- Who can make the agent act through ASI:One ----------------------------------------
# The agent is for the person and their family. Only the sender addresses listed here (agent1q..., comma-separated) can make it
# message, alarm or order anything; everyone else gets a plain refusal. The agent logs each sender once ("ASI sender agent1q...")
# so you can find your own address in its terminal.
ASI_AUTHORIZED=
# closed (default): only ASI_AUTHORIZED can act   |   approve: operator tool, strangers' requests wait for the local API
ASI_MODE=closed

# ---- Local HTTP -------------------------------------------------------------------------
# Residual's screen -> the Relay. Must stay on loopback. Every route needs the token in state/local_token
# (made automatically; or set RESIDUAL_LOCAL_TOKEN to the same value for the Relay and the app).
HTTP_HOST=127.0.0.1
HTTP_PORT=8100
RESIDUAL_LOCAL_TOKEN=
# Photon webhook: a separate, signed, webhook-only server. Point your tunnel here, never at HTTP_PORT.
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8101
CONTACTS_FILE=contacts.json
STATE_DIR=state

# ---- Demo ---------------------------------------------------------------------------
# 1 = escalate after demo_after_s (25 s) instead of 120 s / 60 s. Everything says "demo timing".
DEMO_TIMING=0
# Lets the Lab / a test post a SIMULATED carer reply. Defaults to on only in simulated mode.
ALLOW_SIMULATED_REPLIES=

# ---- Calls (optional) -----------------------------------------------------------------
# Emergency: an unanswered message becomes a call to the same person, then the next person.
# Photon places calls over SIP through a voice provider; point this at whatever starts that call.
# It receives POST {to, name, text, idempotency_key}. Empty = messages only (live), SIMULATED calls (simulated).
VOICE_CALL_WEBHOOK=
VOICE_CALL_SECRET=

# ---- The agent team (swarm/) -------------------------------------------------------------
# On by default: the Relay, one agent per family member (the Care Circle) and the Concierge run together and talk to each
# other as uAgents. Each has its own Agentverse mailbox, so each can also be found and used through ASI:One (see README: "The team").
# RESIDUAL_TEAM=0 runs the Relay alone (the care circle's logic still runs inside it, labelled "local agent" on screen).
RESIDUAL_TEAM=1
# 0 = no Agentverse mailboxes (everything still works on this computer; nothing is reachable from ASI:One)
RESIDUAL_MAILBOX=1
# Optional: a family member's own seed (otherwise derived from AGENT_SEED), e.g. MAYA_AGENT_SEED, RAJ_AGENT_SEED, CONCIERGE_AGENT_SEED, HANDS_AGENT_SEED

# ---- The Hands: Browser Use (https://cloud.browser-use.com) ---------------------------------
# Residual's screen sends web errands straight to Browser Use (through this local Relay), never through ASI:One.
# To ALSO publish the Hands as a chat agent on Agentverse, set HANDS_ON_ASI=1 (off by default).
# With a key the Hands drive a real cloud browser. Without one they run a clearly-labelled SIMULATED browser.
# Only sites listed in care_profile.json -> hands.allowed_hosts are ever visited. Errands never pay; money belongs to the Concierge.
BROWSER_USE_API_KEY=
# How long a family member has to lend their hands (a login, a CAPTCHA) before the next person is asked
HANDS_HELPER_WAIT_S=300
